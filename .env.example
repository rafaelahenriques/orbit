# Copy this file to .env and adjust the values. Never commit .env.

# PostgreSQL credentials for the local Docker database (development only).
POSTGRES_USER=orbit
POSTGRES_PASSWORD=orbit
POSTGRES_DB=orbit

# Google OAuth client for "Sign in with Google". See "Set up Google sign-in" in README.md.
# Leave these empty to run Orbit locally without sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Signs session cookies. Generate one with:
#   openssl rand -hex 32
SESSION_SECRET=

# Encrypts Google tokens in the database. Generate one with:
#   openssl rand -base64 32 | tr '+/' '-_'
# Keep it safe and don't change it: stored tokens can only be read with this key.
TOKEN_ENCRYPTION_KEY=
